<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<VBox
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.SeleccionColorController"
    spacing="30"
    stylesheets="@../styles/estilos.css">

    <Label text ="Elige tu color"/>

    <HBox
        alignment="CENTER"
        spacing="60">

        <ImageView
            fitWidth="100"
            fitHeight="100"
            onMouseClicked="#ElegirBlanco">
            <image>
                <Image url="@../Imagenes/seleccionColorBlanco.png"/>
            </image>
        </ImageView>

        <ImageView
            fitWidth="100"
            fitHeight="100"
            onMouseClicked="#ElegirNegro">
            <image>
                <Image url = "@../Imagenes/seleccionarColorNegro.png"/>
            </image>
        </ImageView>
    </HBox>
</VBox>