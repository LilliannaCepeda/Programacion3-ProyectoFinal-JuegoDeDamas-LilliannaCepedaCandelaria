<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane
     xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.SeleccionColorController"
    stylesheets="@../styles/estilos.css">

    <VBox
        alignment="CENTER"
        spacing="30">

        <Label text ="Elige tu color" style="-fx-font-size: 28px; -fx-text-fill: white;"/>

        <HBox
            alignment="CENTER"
            spacing="200">

            <ImageView
                fitWidth="400"
                fitHeight="400"
                onMouseClicked="#seleccionarBlanco">
                <image>
                    <Image url="@../Imagenes/seleccionColorBlanco.png"/>
                </image>
            </ImageView>

            <ImageView
                fitWidth="400"
                fitHeight="400"
                onMouseClicked="#seleccionarNegro">
                <image>
                    <Image url = "@../Imagenes/seleccionarColorNegro.png"/>
                </image>
            </ImageView>
        </HBox>
    </VBox>
</StackPane>