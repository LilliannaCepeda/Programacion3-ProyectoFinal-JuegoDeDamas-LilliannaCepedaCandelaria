<?xml version = "1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane
    xmlns ="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller= "controller.GanadorController"
    stylesheets="@../styles/estilos.css"
    styleClass="fondoFinPartida">

    <VBox
        AnchorPane.topAnchor="20"
        AnchorPane.bottomAnchor="20"
        AnchorPane.rightAnchor = "20"
        AnchorPane.leftAnchor = "20"
        spacing = "15">
        
        <Label text="¡Fin de la partida!"/>
        <Label fx:id="lblGanador" text = "Ganadador:"/>

        <ImageView
        fx:id="imagenGanador" fitWidth ="100" fitHeight="100"/>
    
        <HBox 
            alignment = "CENTER"
            spacing="30">
            <Button text="Nueva Partida" onAction="#nuevaPartida"/>
            <Button text="Volver a Inicio" onAction="#regresar"/>
        </HBox>
    </VBox>
</AnchorPane>

   
