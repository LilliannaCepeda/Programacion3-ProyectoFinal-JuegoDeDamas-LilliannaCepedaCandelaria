<?xml version = "1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?improt javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane
    xmlns ="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller = "controller.TableroController"
    stylesheets="@../Styles/estilos.css">

    <VBox
        AnchorPane.topAnchor="20"
        AnchorPane.leftAnchor="20" 
        spacing="5">
        <Label fx:id = "colorJugadorArriba" text =""/>
        <Label fx:id="contadorJugadorArriba" text = "12"/>
    </VBox>

    <VBox
        AnchorPane.bottomAnchor="20"
        AnchorPane.rightAnchor = "20"
        spacing = "5">
        <Label fx:id="colorJugadorAbajo" text=""/>
        <Label fx:id="contadorJugadorAbajo" text="12"/>
    </VBox>

    <MenuBotton
        fx:id= "menuOpciones" text="" AnchorPane.topPAnchor="20" AnchorPane.rightAnchor="20">
        <graphic>
            <imageView fitwidth = "30" fitheight="30">
                <image>
                    <image url="@../imagenes/iconoEngranaje.webp"/>
                </image>
            </imageView>
        </graphic>
        <items>
            <MenuItem fx:id = "itemNuevaPartida" text="Nueva Partida" onAction = "#nuevaPartida"/>
            <MenuItem fx:id ="itemSalir" text="Salir" onAction = "#salir"/>
        </items>
    </MenuBotton>

    <GridPane 
    fx:id= "tablero" 
    AnchorPane.topAnchor ="80" 
    AnchorPane.bottomAnchor="80" 
    AnchorPane.leftAnchor="150" 
    AnchorPane.rightAnchor="150">
    </GridPane>
</AnchorPane>