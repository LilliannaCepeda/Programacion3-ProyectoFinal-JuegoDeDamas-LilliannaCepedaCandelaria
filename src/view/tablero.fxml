<?xml version = "1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane
    xmlns ="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller = "controller.TableroController"
    stylesheets="@../Styles/estilos.css">

    <VBox
        AnchorPane.topAnchor="20"
        AnchorPane.leftAnchor="20" 
        spacing="5"
        styleClass="cuadroJugador">
        <Label fx:id = "colorJugadorArriba" text =""/>
        <Label fx:id="contadorJugadorArriba" text = "12"/>
    </VBox>

    <VBox
        AnchorPane.bottomAnchor="20"
        AnchorPane.rightAnchor = "20"
        spacing = "5"
        styleClass="cuadroJugador">
        <Label fx:id="colorJugadorAbajo" text=""/>
        <Label fx:id="contadorJugadorAbajo" text="12"/>
    </VBox>

    <MenuButton
        fx:id= "menuOpciones" text="" AnchorPane.topAnchor="20" AnchorPane.rightAnchor="20">
        <graphic>
            <ImageView fitWidth = "30" fitHeight="30">
                <image>
                    <Image url="@../Imagenes/IconoEngranaje.png"/>
                </image>
            </ImageView>
        </graphic>
        <items>
            <MenuItem fx:id = "itemNuevaPartida" text="Nueva Partida" />
            <MenuItem fx:id ="itemSalir" text="Salir"/>
        </items>
    </MenuButton>

    <GridPane 
        fx:id= "tableroGrid" 
        AnchorPane.topAnchor ="100" 
        AnchorPane.bottomAnchor="200" 
        AnchorPane.leftAnchor="450" 
        AnchorPane.rightAnchor="250">
    </GridPane>
   
</AnchorPane>