<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>

<StackPane
     xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.SeleccionColorController"
    stylesheets="@../styles/estilos.css"
    styleClass="root">

    <Pane styleClass="capaFondo" />

    <VBox
        alignment="CENTER"
        spacing="30">

        <Text text ="Elige tu color" styleClass="tituEleccion"/>

        <HBox
            alignment="CENTER"
            spacing="100">

            <VBox alignment="CENTER" styleClass="contenedorCaja">
                <ImageView
                    fitWidth="400"
                    preserveRatio="true"
                    onMouseClicked="#seleccionarBlanco">
                    <image>
                        <Image url="@../Imagenes/cajaFichasBlancas.png"/>
                    </image>
                </ImageView>
            </VBox>

            <VBox alignment="CENTER" styleClass="contenedorCaja">
                <ImageView
                    fitWidth="400"
                    preserveRatio="true"
                    onMouseClicked="#seleccionarNegro">
                    <image>
                        <Image url = "@../Imagenes/cajaFichasNegras.png"/>
                    </image>
                </ImageView>
            </VBox>

        </HBox>
    </VBox>
</StackPane>